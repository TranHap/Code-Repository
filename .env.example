# Copier ce fichier en .env et y mettre votre clé (facultatif : sans clé, seuls le chat et l'import sont indisponibles).
# Tout service compatible avec l'API OpenAI convient. Exemple avec Google Gemini (clé gratuite sur aistudio.google.com) :
ZAI_API_KEY=votre_cle
ZAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
TEXT_MODEL=gemini-2.5-flash
VISION_MODEL=gemini-2.5-flash
